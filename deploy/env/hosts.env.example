# /etc/noorcom-branding/hosts.env  (root, mode 644)
# The names deploy-branding.sh --install writes into the nginx site (docs/VPS_BRANDING.md).
# Staging first; at cutover SITE_HOST=noorcombranding.co.ke and WWW_HOST=www.noorcombranding.co.ke.
SITE_HOST=staging.noorcombranding.co.ke
# Live site only: www goes to the bare name (leave unset on staging).
# WWW_HOST=www.noorcombranding.co.ke
# Staging only: tell search engines not to index it (remove at cutover).
NOINDEX=yes
