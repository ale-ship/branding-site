# /etc/noorcom-branding/web.env  (owner root:noorcom-branding, mode 640)
# NEXT_PUBLIC_SITE_URL is baked in when deploy-branding.sh runs `next build`, so changing it
# needs a deploy, not only a restart. Nothing here is secret yet.
NODE_ENV=production
PORT=4301
HOSTNAME=127.0.0.1
NEXT_PUBLIC_SITE_URL=https://<SITE_HOST>
