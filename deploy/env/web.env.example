# /etc/noorcom-branding/web.env  (owner root:noorcom-branding, mode 640)
# NEXT_PUBLIC_* are baked in when deploy-branding.sh runs `next build`, so changing one needs a
# deploy, not only a restart. Nothing here is secret yet; the backend's settings go in api.env
# (docs/BACKEND_RUNBOOK.md section 11) from step B1 on.
NODE_ENV=production
PORT=4301
HOSTNAME=127.0.0.1
NEXT_PUBLIC_SITE_URL=https://staging.noorcombranding.co.ke
