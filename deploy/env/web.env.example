# /etc/noorcom-branding/web.env  (owner root:noorcom-branding, mode 640)
# NEXT_PUBLIC_* are baked in when deploy-branding.sh runs `next build`, so changing one needs a
# deploy, not only a restart. No quotes around values: systemd and the deploy read this file.
NODE_ENV=production
PORT=4301
HOSTNAME=127.0.0.1
NEXT_PUBLIC_SITE_URL=https://staging.noorcombranding.co.ke
# The site runs on our backend (docs/BACKEND_RUNBOOK.md, section 12).
NEXT_PUBLIC_API_MODE=live
API_INTERNAL_URL=http://127.0.0.1:4300
# The same value as in api.env (openssl rand -hex 32): the API asks the site to refresh after staff
# change the website.
REVALIDATE_SECRET=<SAME_AS_API_ENV>
# Payments by hand until Absa's prompt is connected; then NEXT_PUBLIC_PAYMENTS_MODE=prompt.
# NEXT_PUBLIC_PAYMENTS_MODE=prompt
