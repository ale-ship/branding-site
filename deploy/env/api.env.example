# /etc/noorcom-branding/api.env  (owner root:noorcom-branding, mode 640). The API and the worker.
# Every setting is explained in backend/.env.example; docs/BACKEND_RUNBOOK.md, section 11.
# No quotes around values: systemd and the deploy read this file. Secrets: openssl rand -hex 32,
# made on the box and never shown or copied off it.
NODE_ENV=production
HOST=127.0.0.1
PORT=4300
SITE_ORIGIN=https://staging.noorcombranding.co.ke
PUBLIC_URL=https://staging.noorcombranding.co.ke
DATABASE_URL=postgres://noorcom_branding:<NB_DB_PASSWORD>@127.0.0.1:5432/noorcom_branding
REDIS_URL=redis://nb:<NB_REDIS_PASSWORD>@127.0.0.1:6379/0
LOG_LEVEL=info
# Payments by hand (owner, 21 Oct 2026); WhatsApp off until there's a Business account.
PAYMENTS_MODE=manual
ABSA_MODE=fake
DARAJA_MODE=fake
WHATSAPP_MODE=off
STORAGE_MODE=fake
ABSA_PAYBILL=303030
# Email through the info@ mailbox on the domain's cPanel account (noorcombranding; Email Accounts,
# Connect Devices shows the outgoing server): sign-in codes, order messages, quote requests. The
# API refuses to start on the live address without SMTP_HOST.
MAIL_FROM=Noorcom Branding <info@noorcombranding.co.ke>
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=465
SMTP_USER=info@noorcombranding.co.ke
SMTP_PASS=<SMTP_PASSWORD>
STAFF_INBOX=info@noorcombranding.co.ke
# Files on the box until R2 (all under /var/lib/noorcom-branding, which the backup copies).
STORAGE_DIR=/var/lib/noorcom-branding/storage
MAIL_OUTBOX_DIR=/var/lib/noorcom-branding/mail-outbox
WHATSAPP_OUTBOX_DIR=/var/lib/noorcom-branding/whatsapp-outbox
FILES_SECRET=<openssl rand -hex 32>
SITE_INTERNAL_URL=http://127.0.0.1:4301
REVALIDATE_SECRET=<openssl rand -hex 32, the same in web.env>
