# The backend's settings (docs/BACKEND_RUNBOOK.md, section 11). Copy to .env for development;
# on the VPS they live in /etc/noorcom-branding/api.env. Never commit a real one.
NODE_ENV=development
HOST=127.0.0.1
PORT=4300
# The site, for CORS-free server-to-server calls and links in messages.
SITE_ORIGIN=http://localhost:3000
# postgres://noorcom_branding:<password>@127.0.0.1:5432/noorcom_branding
DATABASE_URL=
# A separate database the tests may empty: postgres://noorcom_branding:<password>@127.0.0.1:5432/noorcom_branding_test
TEST_DATABASE_URL=
# The ACL user `nb`, which may only touch keys `nb:*`: redis://nb:<password>@127.0.0.1:6379/0
REDIS_URL=
# Tests use their own Redis database number: redis://nb:<password>@127.0.0.1:6379/15
TEST_REDIS_URL=
LOG_LEVEL=
BUILD_ID=
# Integrations: fake until each goes live (section 2.3). Live Absa, Daraja, WhatsApp and storage
# aren't built yet, and the API refuses to start with them set to live.
ABSA_MODE=fake
DARAJA_MODE=fake
WHATSAPP_MODE=fake
STORAGE_MODE=fake
# Where the API is reached from outside (callbacks, links). Fakes refuse the live site's address.
PUBLIC_URL=http://127.0.0.1:4300
# The secret path segment on Absa's callback URLs; production needs 24+ random characters
# (openssl rand -hex 24). Development uses a fixed one when empty.
ABSA_CALLBACK_SECRET=
ABSA_PAYBILL=303030
# Fake mode: how long the fake Absa takes to answer an M-Pesa prompt.
FAKE_STK_DELAY_MS=6000
# Email: with SMTP_HOST empty, messages are written as .eml files into MAIL_OUTBOX_DIR instead.
MAIL_FROM=Noorcom Branding <info@noorcombranding.co.ke>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_OUTBOX_DIR=.mail-outbox
# The fake WhatsApp writes each message as JSON here.
WHATSAPP_OUTBOX_DIR=.whatsapp-outbox
