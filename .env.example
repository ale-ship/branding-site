# Copy to .env.local for local work. Nothing here is secret.

# The site's public address, used for canonical URLs, the sitemap, robots.txt, Open Graph and
# JSON-LD. Baked in at build time: change it, then rebuild.
#   local:  http://localhost:3000
#   live:   https://noorcombranding.co.ke
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where data comes from: `mock` (default) or `live`. Live serves what our backend already does
# (docs/BACKEND_RUNBOOK.md: from step B1 the order catalogue and the price) from the API, the rest
# from the mock. Baked in at build time. With `live`, the API must be running for `npm run build`.
NEXT_PUBLIC_API_MODE=mock
# The backend, reached from the site's server only (never the browser).
API_INTERNAL_URL=http://127.0.0.1:4300
